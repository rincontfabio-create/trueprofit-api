# Copia este archivo como .env y cambia los valores. El .env NUNCA se sube a Git.

# Clave que la interfaz envía a la API en la cabecera X-API-Key.
# Genera una con:  uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
TRUEPROFIT_API_KEY=cambia-esta-clave

# Dónde encuentra la interfaz a la API cuando corres sin Docker.
# (Con docker compose se sobrescribe a http://api:8000.)
TRUEPROFIT_API_URL=http://localhost:8000
